# ==============================================================================
# SİKKELOBEDİ NÜMİZMATİK KATALOG - cPANEL PRODUCTION ÇEVRE DEĞİŞKENLERİ
# ==============================================================================

APP_NAME="Sikkelobedi Numismatics"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en

# cPanel Domain veya Alt Klasör URL'si (Sondaki slash olmadan)
# Örn kök domain: https://sikkelobedi.com
# Örn admin alt klasör: https://sikkelobedi.com/admin
APP_URL=https://yourdomain.com

# cPanel Paylaşımlı Hosting Loglama (Günlük döndürmeli)
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# cPanel MySQL Veritabanı Yapılandırması
# cPanel -> MySQL Veritabanları menüsünden oluşturulan kullanıcı ve DB adı
# Genellikle "{cpanel_kullanici_adi}_{veritabani_adi}" formatındadır.
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_numismatics
DB_USERNAME=cpaneluser_numisadmin
DB_PASSWORD=YourUltraSecurePassword2026!
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# cPanel Oturum, Önbellek ve Kuyruk (Bellek Dostu Dosya / Veritabanı)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=file
CACHE_PREFIX=numis_prod_

# ------------------------------------------------------------------------------
# Dosya Depolama
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public

# ------------------------------------------------------------------------------
# Mail Bildirimleri (cPanel Kurumsal Webmail / SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=info@yourdomain.com
MAIL_PASSWORD=EmailPassword123!
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Filament v3 Panel Ayarları
# ------------------------------------------------------------------------------
FILAMENT_PATH=admin

