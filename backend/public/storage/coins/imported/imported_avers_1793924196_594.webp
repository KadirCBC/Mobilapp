            <div id="pnlLogin" onkeypress="javascript:return WebForm_FireDefaultButton(event, &#39;cmdLogin&#39;)">
	
                        <div class="popup-box">
                            <div class="fancy-inner">
                                <div class="heading">Login</div>
                            </div>
                            <div class="popup-inner">
                                <div id="divFollowStore" class="message-popup">By following a store you can set the frequency you would like to receive a notification of new items added by this store. Please login below.</div>
                                
								
                                <div class="popup-form">
                                    <label>User ID or Email:</label>
                                    <input name="txtUsername" type="text" id="txtUsername" />
                                </div>
                                <div class="popup-form">
                                    <label>Password:</label>
                                    <input name="txtPassword" type="password" id="txtPassword" autocomplete="new-password" />
                                </div>
                                <input type="submit" name="cmdLogin" value="Login" id="cmdLogin" class="btn" />
                                <p><span id="litError" class="message-error"></span></p>
                                <p><a href="/modules/main/login/RecoverPassword.aspx?idLanguage=1" id="recoverpassword">Forgot your password?</a></p>
                                <p><a href="/en/Register.aspx" target="_parent">Register</a></p>
