<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Otomatik HTTPS Yönlendirmesi (SSL Zorunlu)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Authorization Header'ını PHP'ye İlet (API Token ve Sanctum İçin)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 3. Sondaki Fazla Slash'ı Temizle
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 4. Doğrudan Dosya veya Klasör Değilse index.php'ye Yönlendir
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# 5. Güvenlik: Hassas Dosyaları ve Dizin Taramasını Engelle
<FilesMatch "^\.|\.env|composer\.(json|lock)|package\.(json|lock)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 6. cPanel GZIP / Brotli Sıkıştırma (Hızlı Mobil & Web Yükleme)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# 7. Temel Güvenlik Başlıkları
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

